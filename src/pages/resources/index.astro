---
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib/content';

const posts = await getPosts('resources');
---

<Base
  title="Resources — Hobbes Digital"
  description="Practical, evergreen guides on digital marketing, AI tools, and what actually works for small businesses in Singapore and SE Asia."
>

  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Resources</span>
      <h1>Practical guides for business owners.</h1>
      <p class="lead">
        Plain-English writing on digital marketing, AI tools, and what
        actually works for small businesses in Singapore and SE Asia.
        Kept up to date. No jargon, no vanity metrics.
      </p>
    </div>
  </section>

  <section class="resources-list">
    <div class="container">
      {posts.length === 0 ? (
        <p class="post-empty">No guides published yet.</p>
      ) : (
        posts.map((post) => (
          <a href={`/resources/${post.slug}`} class="resource-card">
            <div class="resource-card-meta">
              <span class="eyebrow">{formatDate(post.data.pubDate)}</span>
              {post.data.draft && <span class="post-draft">Draft</span>}
              {post.data.tags.map((tag) => <span class="resource-tag">{tag}</span>)}
            </div>
            <h2 class="resource-card-title">{post.data.title}</h2>
            <p class="resource-card-desc">{post.data.description}</p>
            <span class="resource-card-link">Read guide →</span>
          </a>
        ))
      )}
    </div>
  </section>

</Base>
