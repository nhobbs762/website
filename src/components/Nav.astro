---
const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<nav class="nav">
  <div class="container">
    <div class="nav-inner">
      <a href="/" class="nav-logo">Hobbes<span>.</span></a>
      <ul class="nav-links">
        <li><a href="/" class:list={{ active: isActive('/') }}>Home</a></li>
        <li><a href="/resources" class:list={{ active: isActive('/resources') }}>Resources</a></li>
        <li><a href="/blog" class:list={{ active: isActive('/blog') }}>Blog</a></li>
      </ul>
      <div class="nav-right">
        <a href="mailto:hello@hobbes.sg" class="btn btn-dark">Get in touch</a>
      </div>
    </div>
  </div>
</nav>
