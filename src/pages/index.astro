---
import Base from '../layouts/Base.astro';
import { getPosts, formatDate, isoDate } from '../lib/content';

const [posts, guides] = await Promise.all([getPosts('blog'), getPosts('resources')]);
const latestPosts = posts.slice(0, 3);
const latestGuides = guides.slice(0, 3);
---

<Base
  title="Hobbes Digital — practical marketing for small businesses"
  description="We help small business owners in Singapore and SE Asia build a steady, predictable flow of customers. Practical marketing, measured against revenue."
>

  <section class="hero">
    <div class="container">
      <span class="eyebrow hero-eyebrow">Singapore · SE Asia</span>
      <h1>Practical marketing, <em>measured against revenue.</em></h1>
      <p class="lead hero-lead">
        We help small business owners build a steady, predictable flow of
        customers — without the agency overhead, the jargon, or the vanity
        metrics. The person who writes the strategy is the person who runs it.
      </p>
      <div class="hero-actions">
        <a href="/resources" class="btn btn-primary">Read the guides</a>
        <a href="/blog" class="btn btn-secondary">Latest posts</a>
      </div>
    </div>
  </section>

  <section class="home-split">
    <div class="container">
      <div class="home-split-grid">
        <div>
          <span class="eyebrow">Resources</span>
          <h2>Evergreen guides.</h2>
          <p>
            Long-form, plain-English writing on digital marketing and AI
            tools. Written to stay useful, and kept up to date.
          </p>
          <a href="/resources" class="home-split-link">Browse all guides →</a>
          {latestGuides.length > 0 && (
            <ul class="home-mini-list">
              {latestGuides.map((guide) => (
                <li>
                  <a href={`/resources/${guide.slug}`}>{guide.data.title}</a>
                </li>
              ))}
            </ul>
          )}
        </div>
        <div>
          <span class="eyebrow">Blog</span>
          <h2>Notes from the work.</h2>
          <p>
            Shorter and timelier — what we're trying, what's working, and
            what turned out to be wrong.
          </p>
          <a href="/blog" class="home-split-link">Read the blog →</a>
          {latestPosts.length > 0 && (
            <ul class="home-mini-list">
              {latestPosts.map((post) => (
                <li>
                  <a href={`/blog/${post.slug}`}>{post.data.title}</a>
                  <time datetime={isoDate(post.data.pubDate)}>
                    {formatDate(post.data.pubDate)}
                  </time>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="home-contact">
    <div class="container">
      <div class="home-contact-inner">
        <span class="eyebrow">Get in touch</span>
        <h2>Tell us about your business.</h2>
        <p>
          We'll tell you what we'd do. No pressure and no pitch deck — a
          conversation, and a written note afterwards either way.
        </p>
        <a href="mailto:hello@hobbes.sg" class="btn btn-primary">hello@hobbes.sg</a>
      </div>
    </div>
  </section>

</Base>
